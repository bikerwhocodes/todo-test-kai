# NextUp environment variable NAMES.
#
# This file intentionally carries NO VALUES. The repository is public and the
# product's defining requirement is that saved data stays private, so no
# credential — not even a local development one — is committed here.
#
# Generate a real .env.local with locally-random passwords:
#
#     npm run env:init
#
# That writes .env.local (git-ignored) and is the only setup step required.

# Superuser connection. Used ONLY by `npm run db:setup` to create the two
# application roles below. The application never uses this.
POSTGRES_SUPERUSER_URL=

# Migration owner: owns every table. Runs migrations. NOT used at runtime.
MIGRATION_DATABASE_URL=

# Application runtime role: not the table owner, not a superuser, no BYPASSRLS.
# Serves every ordinary request. Has DML on the six domain tables and own-row
# access to users, and DELIBERATELY no privilege on sessions/accounts/
# verifications/rate_limits.
DATABASE_URL=

# Auth role: used ONLY by lib/auth.ts (Better Auth). Has DML on the four
# identity tables plus rate_limits, and DELIBERATELY no privilege on ANY
# domain table. It must read users by email and sessions by token before a
# request has any identity, which no app.user_id policy can express.
# Neither this role nor DATABASE_URL's is a superset of the other; the startup
# guard asserts both directions. See db/migrations/004_auth_role.sql.
AUTH_DATABASE_URL=

# Signing secret for session cookies. Generate a long random value; never
# commit one. `npm run env:init` writes a locally-random secret.
BETTER_AUTH_SECRET=

# Public origin of this deployment. Used for cookie scope and as the CSRF
# trusted origin, so a wrong value here breaks sign-in rather than failing open.
BETTER_AUTH_URL=

# Passwords consumed by docker-compose.yml and db/setup.ts.
POSTGRES_PASSWORD=
NEXTUP_OWNER_PASSWORD=
NEXTUP_RUNTIME_PASSWORD=
NEXTUP_AUTH_PASSWORD=

# Optional. Isolate another checkout without rotating its existing secrets:
# NEXTUP_DB_PORT=56551 COMPOSE_PROJECT_NAME=nextup-copy npm run env:init
COMPOSE_PROJECT_NAME=
NEXTUP_DB_PORT=
