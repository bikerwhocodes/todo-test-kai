# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nextup
# Database used by integration tests (it is migrated and truncated by the tests)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/nextup_test
# Public origin of the app; Better Auth uses it for cookies and origin checks
BETTER_AUTH_URL=http://localhost:3000
# At least 32 random characters, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars
# Optional, production: header(s) that carry the real client IP for auth rate limiting
# AUTH_IP_HEADERS=x-real-ip
# AUTH_TRUSTED_PROXIES=10.0.0.0/8
