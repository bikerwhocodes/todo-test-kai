# NextUp environment variable NAMES.
#
# This file intentionally carries NO VALUES. The repository is public and the
# product's defining requirement is that saved data stays private, so no
# credential — not even a local development one — is committed here.
#
# Generate a real .env.local with locally-random passwords:
#
#     npm run env:init
#
# That writes .env.local (git-ignored) and is the only setup step required.

# Superuser connection. Used ONLY by `npm run db:setup` to create the two
# application roles below. The application never uses this.
POSTGRES_SUPERUSER_URL=

# Migration owner: owns every table. Runs migrations. NOT used at runtime.
MIGRATION_DATABASE_URL=

# Application runtime role: not the table owner, not a superuser, no BYPASSRLS.
# This is the only connection the application is allowed to use.
DATABASE_URL=

# Passwords consumed by docker-compose.yml and db/setup.ts.
POSTGRES_PASSWORD=
NEXTUP_OWNER_PASSWORD=
NEXTUP_RUNTIME_PASSWORD=
