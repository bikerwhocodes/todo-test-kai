# NextUp environment variable NAMES.
#
# This file intentionally carries NO VALUES. The repository is public and the
# product's defining requirement is that saved data stays private, so no
# credential — not even a local development one — is committed here.
#
# Generate a real .env.local with locally-random passwords:
#
#     npm run env:init
#
# That writes .env.local (git-ignored) and is the only setup step required.

# Superuser connection. Used ONLY by `npm run db:setup` to create the two
# application roles below. The application never uses this.
POSTGRES_SUPERUSER_URL=

# Migration owner: owns every table. Runs migrations. NOT used at runtime.
MIGRATION_DATABASE_URL=

# Application runtime role: not the table owner, not a superuser, no BYPASSRLS.
# Holds DML on the six user tables and own-row access to `users`, and NOTHING
# on sessions/accounts/verifications. Every application query uses this.
DATABASE_URL=

# Auth library role: DML on users/sessions/accounts/verifications/rate_limits
# and NOTHING on the six user tables. Used only by lib/auth.ts, because the
# pre-identity reads that sign-in needs cannot be expressed as an RLS policy.
# See db/migrations/004_auth_role.sql.
AUTH_DATABASE_URL=

# Signing/encryption secret for sessions. Generate with:
#     openssl rand -base64 32
# `npm run env:init` generates one locally. Required in production.
BETTER_AUTH_SECRET=

# Public origin of the app. Used as the auth base URL and as the single
# trusted origin for CSRF checks.
BETTER_AUTH_URL=

# Passwords consumed by docker-compose.yml and db/setup.ts.
POSTGRES_PASSWORD=
NEXTUP_OWNER_PASSWORD=
NEXTUP_RUNTIME_PASSWORD=
NEXTUP_AUTH_PASSWORD=

# Optional. Only needed when two clones of this repository run on one machine:
# the compose project name otherwise defaults to the directory name for both,
# and they fight over one container. See docker-compose.yml.
COMPOSE_PROJECT_NAME=
NEXTUP_DB_PORT=
